# ==============================================================================
# SECTION 1: Setup and Configuration
# ==============================================================================

setwd("...")   # Set your working directory

CSV_IN   <- "deixis_final_novel.csv"                 # written by Script A
OUT_PDF  <- "figure1_deictic_withdrawal.pdf"         # vector, for submission
OUT_PNG  <- "figure1_deictic_withdrawal.png"         # 600 dpi, for drafts
