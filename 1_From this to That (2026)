# Canonical form: letters and digits only, which makes tokenisation (clitics,
# curly quotes, punctuation spacing) irrelevant. For strings of 25 characters
# or more the odds of a spurious match are negligible.
canon <- function(s) gsub("[^a-z0-9]+", "", tolower(s))

match_title <- function(p) {
    b <- tolower(basename(p))
    if (identical(basename(p), BRYS_FILE)) return(NA_character_)
    keys <- c("dusklands", "heart", "barbarians", "michael", "foe", "iron",
              "petersburg", "boyhood", "disgrace", "youth", "costello", "slow",
              "diary", "summertime", "childhood", "schooldays", "death", "pole")
    hit <- keys[vapply(keys, function(k) grepl(k, b, fixed = TRUE), logical(1))]
    if (!length(hit)) return(NA_character_)
    meta_person$title[match(hit[which.max(nchar(hit))], keys)]
}

txts <- list.files(pattern = "\\.txt$", full.names = TRUE)
tt   <- vapply(txts, match_title, character(1))
txts <- txts[!is.na(tt)]
tt   <- tt[!is.na(tt)]

if (!length(txts) || !all(file.exists(KWIC_FILES))) {
    verdict("source .txt files and concordance CSVs present", FALSE)
} else {
    srcnorm <- new.env()
    for (j in seq_along(txts))
        assign(tt[j], canon(paste(readLines(txts[j], warn = FALSE), collapse = " ")),
               envir = srcnorm)
    tot  <- 0
    fnd  <- 0
    miss <- character(0)
    for (kf in KWIC_FILES) {
        kk <- fread(kf)
        kk <- kk[order(-score)][, head(.SD, 3), by = novel]     # top 3 per work
        for (r in seq_len(nrow(kk))) {
            nv <- kk$novel[r]
            if (!exists(nv, envir = srcnorm)) next
            ndl <- canon(kk$sentence[r])
            if (nchar(ndl) < 25) next                            # too short to test
            tot <- tot + 1
            hit <- grepl(ndl, get(nv, envir = srcnorm), fixed = TRUE)
            if (hit) fnd <- fnd + 1
            else miss <- c(miss, sprintf("%s: %.60s...", nv, kk$sentence[r]))
        }
    }
    pct <- 100 * fnd / max(tot, 1)
    verdict(sprintf("verbatim match rate %.1f%% (%d/%d) >= 95%%", pct, fnd, tot),
            pct >= 95)
    if (length(miss)) {
        add("      unmatched (tokeniser artefacts -- verify by hand before quoting):")
        for (ms in head(miss, 8)) add("        %s", ms)
    }
}


