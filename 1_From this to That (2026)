# ==============================================================================
# SECTION 5: Annotation and Classification
# ==============================================================================
#
# match_title() returns a title for a filename only if the filename contains a
# known meta$key. Anything else (the norms file, READMEs, notes) returns NA and
# is excluded, which is what keeps non-corpus .txt files out of the parse.
# To force re-annotation after adding or renaming files, delete CACHE_FILE.

match_title <- function(p) {
    b <- tolower(basename(p))
    if (identical(basename(p), BRYS_FILE)) return(NA_character_)   # never a text
    h <- meta[vapply(meta$key, function(k) grepl(k, b, fixed = TRUE), logical(1)), ]
    if (!nrow(h)) NA_character_ else h$title[which.max(nchar(h$key))]
}

if (file.exists(CACHE_FILE)) {
    message("Loading cached annotation...")
    annot <- as.data.table(readRDS(CACHE_FILE))
} else {
    message("No cache -- annotating .txt files (one-time, slow: a few min per work)...")
    mf <- list.files(pattern = "^english-ewt.*\\.udpipe$")
    if (!length(mf)) mf <- udpipe_download_model(language = "english-ewt")$file_model
    ud <- udpipe_load_model(mf[1])

    txts   <- list.files(pattern = "\\.txt$", full.names = TRUE)
    titles <- vapply(txts, match_title, character(1))
    keep   <- !is.na(titles)
    if (!any(keep))
        stop("No .txt files in the working directory matched meta$key.")
    skipped <- basename(txts[!keep])
    if (length(skipped))
        message("  skipping non-corpus .txt files: ", paste(skipped, collapse = ", "))
    txts   <- txts[keep]
    titles <- titles[keep]
    message("  matched ", length(txts), " works.")

    annot <- rbindlist(lapply(seq_along(txts), function(i) {
        message("  annotating [", i, "/", length(txts), "]: ", titles[i])
        raw <- tryCatch(readLines(txts[i], warn = FALSE, encoding = "UTF-8"),
                        error = function(e) readLines(txts[i], warn = FALSE))
        a <- as.data.table(udpipe_annotate(ud, x = paste(raw, collapse = "\n"),
                                           doc_id = titles[i]))
        a[, novel := titles[i]]
        a
    }), fill = TRUE)

    saveRDS(annot, CACHE_FILE)
    message("  cached annotation -> ", CACHE_FILE)
}

