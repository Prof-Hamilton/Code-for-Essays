d <- read.csv(CSV_IN, stringsAsFactors = FALSE)
stopifnot(all(c("novel", "year", "prop_w") %in% names(d)))
d <- d[!is.na(d$year) & !is.na(d$prop_w), c("novel", "year", "prop_w")]
d <- d[order(d$year), ]

# short labels for the plot
short <- c(
    "Dusklands"                   = "Dusklands",
