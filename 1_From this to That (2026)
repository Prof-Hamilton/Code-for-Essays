add("")
add("-- PART 4: stratified audit sample --")

if (exists("annot")) {
    pool <- list()
    for (i in seq_len(nrow(meta_person))) {
        ttl <- meta_person$title[i]
        if (!ttl %in% annot$novel) next
        a <- annot[novel == ttl]
        a[, is_word := !(upos %in% c("PUNCT", "SYM"))]
        fl <- build_dialogue_flags(a$token, a$upos, a$paragraph_id,
                                   strip_quotes = meta_person$strip_quotes[i])
        a[, in_dialogue := fl$in_dialogue]
        mm <- deixis_masks(a)
        grab <- function(mask, kind) {
            ix <- which(mask)
            if (!length(ix)) return(NULL)
            data.frame(novel = ttl, year = meta_person$year[i], kind = kind,
                       node = a$token[ix], sentence = a$sentence[ix],
                       stringsAsFactors = FALSE)
        }
        pool[[paste0(ttl, "b")]] <- grab(mm$bare_dist, "bare_distal")
        pool[[paste0(ttl, "p")]] <- grab(mm$prox_adn,  "prox_adnominal")
        pool[[paste0(ttl, "i")]] <- grab(mm$imm,       "prox_immediacy")
    }
    pool <- rbindlist(pool)

    # Stratified: N_AUDIT_PER_CAT/2 per category and era. The explicit loop
    # avoids data.table's .SD-with-derived-'by' dropping columns in some
    # versions.
    pool[, era := ifelse(year <= 1997, "early", "late")]
    half  <- as.integer(N_AUDIT_PER_CAT / 2)
    parts <- list()
    for (kk in unique(pool$kind)) for (ee in c("early", "late")) {
        sub  <- pool[kind == kk & era == ee]
        nsub <- nrow(sub)
        if (nsub == 0) next
        parts[[paste(kk, ee)]] <- sub[sample(nsub, min(nsub, half))]
    }
    samp <- rbindlist(parts)
    samp[, human_correct := ""]
    ord <- c("kind", "era", "novel", "year", "node", "sentence", "human_correct")
    ord <- ord[ord %in% names(samp)]          # defensive: reorder existing columns
    setcolorder(samp, ord)
    fwrite(samp, AUDIT_OUT)
    verdict(sprintf("audit sample written: %s (%d rows; code human_correct as 1/0)",
                    AUDIT_OUT, nrow(samp)), TRUE)
    add("      then run: precision_report(\"%s\")", AUDIT_OUT)
} else {
    verdict("cache available for audit sampling", FALSE)
}

precision_report <- function(path = AUDIT_OUT) {
    d <- fread(path)
    d <- d[human_correct %in% c("0", "1", 0, 1)]
    if (!nrow(d)) {
        cat("No coded rows yet -- fill 'human_correct' with 1/0 first.\n")
        return(invisible())
    }
    d[, ok := as.integer(human_correct)]
    out <- d[, .(n = .N, precision = round(100 * mean(ok), 1)), by = kind]
    cat("\nManual audit precision:\n")
    print(out)
    cat(sprintf("\nOverall: %.1f%% (n=%d)\n", 100 * mean(d$ok), nrow(d)))
    invisible(out)
}

