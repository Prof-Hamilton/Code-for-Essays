        sum(m$prox_adn) == 2 && all(which(m$prox_adn) == c(6, 8)))
verdict("imm includes bare this + here + now (rows 10, 11, 12)",
        sum(m$imm) == 3 && all(which(m$imm) == c(10, 11, 12)))
verdict("here_now == 2 and excludes dialogue and 'Now' as noun",
        sum(m$here_now) == 2 && all(which(m$here_now) == c(11, 12)))
verdict("complementiser, relativiser, and existential all excluded",
        !m$bare_dist[3] && !m$bare_dist[4] && !m$imm[13])
verdict("dialogue exclusion works (rows 14, 15 in no mask)",
        !m$bare_dist[14] && !m$here_now[15])

# rate arithmetic: 15 narration words (17 rows, all words, minus 2 in dialogue)
nw <- sum(gt$is_word & !gt$in_dialogue)
verdict("rate arithmetic: bare 2/15 words -> 133.33 per 1,000",
        abs(1000 * sum(m$bare_dist) / nw - 133.3333) < 0.01)

# ranking regressions, including the post-nominal relativiser trap
verdict("ranking: relativiser after a noun demoted below a genuine demonstrative",
        score_bare_distal("as he would a porpoise thrown up by the waves, that would shortly expire",
                          "would", "NOUN") <
        score_bare_distal("That was how it was.", "was", ""))
verdict("ranking: sentence-initial genuine 'That' not demoted",
        score_bare_distal("That is his temperament.", "is", "") >= 4)
verdict("ranking: subordinator-initial proximal penalised below a crisp one",
        score_prox("If I abandon this room, locking the door, stuffing the cracks with rags, I will in time find myself abandoning another room.", 0) <
        score_prox("He put down this cup and looked at her.", 0))


