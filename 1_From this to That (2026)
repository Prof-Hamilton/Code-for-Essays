# ---- Dialogue detection (identical to Script A; needed to keep the -----------
# ---- concordance to narration) ----------------------------------------------
detect_quote_marker <- function(token, upos) {
    q    <- upos == "PUNCT"
    n_cd <- sum(q & token %in% c("\u201C", "\u201D"))
    n_sd <- sum(q & token == "\"")
    n_cs <- sum(q & token %in% c("\u2018", "\u2019"))
    n_ss <- sum(q & token == "'")
    if (n_cd >= 20) "curly_double"
    else if (n_sd >= 20) "straight_double"
    else if (n_cs >= 20) "curly_single"
    else if (n_ss >= 40) "straight_single"
    else "none"
}

build_dialogue_flags <- function(token, upos, para_id,
                                 strip_quotes = TRUE, max_span = 800, peek = 3) {
    n   <- length(token)
    out <- rep(FALSE, n)
    if (!strip_quotes || n == 0)
        return(list(in_dialogue = out, repairs = NA_integer_, marker = "override_off"))

    marker <- detect_quote_marker(token, upos)
    if (marker == "none")
        return(list(in_dialogue = out, repairs = 0L, marker = marker))

    is_q <- upos == "PUNCT" & switch(marker,
        curly_double    = token %in% c("\u201C", "\u201D"),
        straight_double = token == "\"",
        curly_single    = token %in% c("\u2018", "\u2019"),
        straight_single = token == "'")

    role <- rep(NA_character_, n)
    if (marker == "curly_double") {
        role[is_q & token == "\u201C"] <- "open"
        role[is_q & token == "\u201D"] <- "close"
    } else if (marker == "curly_single") {
        role[is_q & token == "\u2018"] <- "open"
        role[is_q & token == "\u2019"] <- "close"
    } else {
        role[is_q] <- "toggle"
    }

    q_idx   <- which(is_q)
    p_start <- which(c(TRUE, para_id[-1] != para_id[-n]))
    ev <- rbind(data.frame(i = p_start, type = "para",  stringsAsFactors = FALSE),
                data.frame(i = q_idx,   type = "quote", stringsAsFactors = FALSE))
    ev <- ev[order(ev$i, ev$type != "para"), ]

    open_at <- NA_integer_
    repairs <- 0L
    spans_s <- integer(0)
    spans_e <- integer(0)
    close_span <- function(a, b) {
        spans_s <<- c(spans_s, a)
        spans_e <<- c(spans_e, b)
    }
    consumed <- rep(FALSE, n)

    for (r in seq_len(nrow(ev))) {
        i <- ev$i[r]
        if (ev$type[r] == "para") {
            if (!is.na(open_at) && i > open_at) {
                w <- q_idx[q_idx >= i & q_idx < i + peek]
                w <- w[!consumed[w] & role[w] %in% c("open", "toggle")]
                if (length(w)) {
                    consumed[w[1]] <- TRUE
                } else {
                    close_span(open_at, i - 1L)
                    open_at <- NA_integer_
                    repairs <- repairs + 1L
                }
            }
        } else {
            if (consumed[i]) next
            rl <- role[i]
            if (is.na(open_at)) {
                if (rl %in% c("open", "toggle")) open_at <- i
            } else {
                if (rl %in% c("close", "toggle")) {
                    close_span(open_at, i)
                    open_at <- NA_integer_
                } else {
                    close_span(open_at, i - 1L)
                    open_at <- i
                    repairs <- repairs + 1L
                }
            }
            if (!is.na(open_at) && i - open_at > max_span) {
                close_span(open_at, i)
                open_at <- NA_integer_
                repairs <- repairs + 1L
            }
        }
    }
    if (!is.na(open_at)) {
        close_span(open_at, n)
        repairs <- repairs + 1L
    }
    for (k in seq_along(spans_s)) out[spans_s[k]:spans_e[k]] <- TRUE
    list(in_dialogue = out, repairs = repairs, marker = marker)
}

# ---- Concordance formatting --------------------------------------------------
clean_ctx <- function(s) {
    s <- gsub("[\r\n\t]+", " ", s)
    s <- gsub(" +", " ", s)
    trimws(s)
}

# ---- Ranking ----------------------------------------------------------------
# The score orders candidate lines for legibility, not for inclusion: every hit
# is written to the CSV, and the score decides which are shown first. For bare
# distal hits it rewards a mid-length sentence and the copular shape, and
# penalises the relativiser trap (a 'that' following a noun).

score_bare_distal <- function(sent, after_word, prev_upos = "") {
    nw <- length(strsplit(sent, "\\s+")[[1]])
    s  <- 0
    if (nw >= 4 && nw <= 32) s <- s + 2 else if (nw > 32 && nw <= 48) s <- s + 1
    aw <- tolower(after_word)
    if (aw %in% c("was", "is", "were", "would", "had", "could", "meant", "seemed"))
        s <- s + 2
    if (aw %in% c("which", "who")) s <- s - 2       # relativiser slipped through
    if (prev_upos %in% c("NOUN", "PROPN")) s <- s - 4   # relativiser trap
    if (grepl("[.!?]\\s*$", trimws(sent))) s <- s + 1   # complete sentence
    s
}

# For proximal hits: crisp, thing-anchored immediacy rather than sprawling
# hypotheticals, so sentence-initial subordinators and very long sentences are
# penalised. Head-noun concreteness is added by the caller via conc_bonus.
SUBORD_INIT <- "^(if|though|although|whether|unless|because|since|while|when|were)\\b"

score_prox <- function(sent, conc_bonus = 0) {
    st <- trimws(sent)
    nw <- length(strsplit(st, "\\s+")[[1]])
    s  <- 0
    if (nw >= 3 && nw <= 24) s <- s + 3
    else if (nw > 24 && nw <= 34) s <- s + 1
    else if (nw > 45) s <- s - 2
    if (grepl(SUBORD_INIT, tolower(st))) s <- s - 3
    if (grepl("[.!?]\\s*$", st)) s <- s + 1
    if (nchar(st) > 320) s <- s - 2
    s + conc_bonus
}

# ---- THE category definitions ------------------------------------------------
# Single source of truth, shared by this script and the validation suite.
# Requires columns: token, lemma, upos, feats, is_word, in_dialogue.
deixis_masks <- function(a) {
    feats <- ifelse(is.na(a$feats), "", a$feats)
    lem   <- tolower(a$lemma)
    tok   <- tolower(a$token)
    is_dem <- ((a$upos == "DET") | (a$upos == "PRON" & grepl("PronType=Dem", feats))) &
              a$upos != "SCONJ" & !grepl("PronType=Rel", feats) &
              lem %in% c("this", "that", "these", "those")
    list(
        bare_dist = is_dem & a$upos == "PRON" & lem %in% c("that", "those") &
                    !a$in_dialogue & a$is_word,
        prox_adn  = is_dem & a$upos == "DET" & lem %in% c("this", "these") &
                    !a$in_dialogue & a$is_word,
        imm       = a$is_word & !a$in_dialogue &
                    ((tok %in% c("here", "now") & a$upos == "ADV") |
                     (lem == "this" & a$upos == "PRON" & grepl("PronType=Dem", feats))),
        here_now  = a$is_word & !a$in_dialogue &
                    tok %in% c("here", "now") & a$upos == "ADV",
        this_dem  = a$is_word & !a$in_dialogue &
                    lem == "this" & grepl("PronType=Dem", feats))
}

# Concreteness lookup -> numeric Conc.M, or NA when norms are unavailable.
conc_lookup <- function(lemma) {
    if (is.null(conc_tab)) return(NA_real_)
