# ==============================================================================

add("")
add("-- PART 2: figures CSV against recomputation from the cache --")

if (!file.exists(CACHE_FILE) || !file.exists(FIGS_CSV)) {
    verdict("cache and figures CSV present", FALSE)
} else {
    annot <- as.data.table(readRDS(CACHE_FILE))
    figs  <- fread(FIGS_CSV)
    worst <- 0
    bad   <- character(0)
    for (i in seq_len(nrow(meta_person))) {
        ttl <- meta_person$title[i]
        if (!ttl %in% annot$novel || !ttl %in% figs$novel) next
        a <- annot[novel == ttl]
        a[, is_word := !(upos %in% c("PUNCT", "SYM"))]
        fl <- build_dialogue_flags(a$token, a$upos, a$paragraph_id,
                                   strip_quotes = meta_person$strip_quotes[i])
        a[, in_dialogue := fl$in_dialogue]
        mm  <- deixis_masks(a)
        nwn <- sum(a$is_word & !a$in_dialogue)
        rc  <- 1000 * sum(mm$bare_dist) / max(nwn, 1)
        ref <- figs[novel == ttl, bare_dist_per1k]
        d   <- abs(rc - ref) / max(ref, 1e-9) * 100
        if (d > worst) worst <- d
        if (d > TOL_PCT) bad <- c(bad, sprintf("%s (%.2f%% off)", ttl, d))
    }
    verdict(sprintf("bare-distal rates match the CSV within %.1f%% (worst %.3f%%)",
                    TOL_PCT, worst), length(bad) == 0)
    if (length(bad)) add("      mismatches: %s", paste(bad, collapse = "; "))
}


