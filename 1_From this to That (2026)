# ---- Dialogue detection ------------------------------------------------------
# A text's quotation convention is read off its own punctuation counts, then
# quoted spans are tracked with a small state machine. An unclosed quotation is
# repaired at the next paragraph boundary unless the new paragraph itself opens
# with a quotation mark, which is the continued-speech convention.

detect_quote_marker <- function(token, upos) {
    q    <- upos == "PUNCT"
    n_cd <- sum(q & token %in% c("\u201C", "\u201D"))
    n_sd <- sum(q & token == "\"")
    n_cs <- sum(q & token %in% c("\u2018", "\u2019"))
    n_ss <- sum(q & token == "'")
    if (n_cd >= 20) "curly_double"
    else if (n_sd >= 20) "straight_double"
    else if (n_cs >= 20) "curly_single"
    else if (n_ss >= 40) "straight_single"
    else "none"
}

build_dialogue_flags <- function(token, upos, para_id,
                                 strip_quotes = TRUE, max_span = 800, peek = 3) {
    n   <- length(token)
    out <- rep(FALSE, n)
    if (!strip_quotes || n == 0)
        return(list(in_dialogue = out, repairs = NA_integer_, marker = "override_off"))

    marker <- detect_quote_marker(token, upos)
    if (marker == "none")
        return(list(in_dialogue = out, repairs = 0L, marker = marker))

    is_q <- upos == "PUNCT" & switch(marker,
        curly_double    = token %in% c("\u201C", "\u201D"),
        straight_double = token == "\"",
        curly_single    = token %in% c("\u2018", "\u2019"),
        straight_single = token == "'")

    role <- rep(NA_character_, n)
    if (marker == "curly_double") {
        role[is_q & token == "\u201C"] <- "open"
        role[is_q & token == "\u201D"] <- "close"
    } else if (marker == "curly_single") {
        role[is_q & token == "\u2018"] <- "open"
        role[is_q & token == "\u2019"] <- "close"
    } else {
        role[is_q] <- "toggle"
    }

    q_idx   <- which(is_q)
    p_start <- which(c(TRUE, para_id[-1] != para_id[-n]))
    ev <- rbind(data.frame(i = p_start, type = "para",  stringsAsFactors = FALSE),
                data.frame(i = q_idx,   type = "quote", stringsAsFactors = FALSE))
    ev <- ev[order(ev$i, ev$type != "para"), ]

    open_at <- NA_integer_
    repairs <- 0L
    spans_s <- integer(0)
    spans_e <- integer(0)
    close_span <- function(a, b) {
        spans_s <<- c(spans_s, a)
        spans_e <<- c(spans_e, b)
    }
    consumed <- rep(FALSE, n)

    for (r in seq_len(nrow(ev))) {
        i <- ev$i[r]
        if (ev$type[r] == "para") {
            # paragraph boundary: continued speech re-opens within `peek` tokens
            if (!is.na(open_at) && i > open_at) {
                w <- q_idx[q_idx >= i & q_idx < i + peek]
                w <- w[!consumed[w] & role[w] %in% c("open", "toggle")]
                if (length(w)) {
                    consumed[w[1]] <- TRUE
                } else {
                    close_span(open_at, i - 1L)
                    open_at <- NA_integer_
                    repairs <- repairs + 1L
                }
            }
        } else {
            if (consumed[i]) next
            rl <- role[i]
            if (is.na(open_at)) {
                if (rl %in% c("open", "toggle")) open_at <- i
            } else {
                if (rl %in% c("close", "toggle")) {
                    close_span(open_at, i)
                    open_at <- NA_integer_
                } else {
                    close_span(open_at, i - 1L)
                    open_at <- i
                    repairs <- repairs + 1L
                }
            }
            # a runaway span is closed rather than allowed to swallow narration
            if (!is.na(open_at) && i - open_at > max_span) {
                close_span(open_at, i)
                open_at <- NA_integer_
                repairs <- repairs + 1L
            }
        }
    }
    if (!is.na(open_at)) {
        close_span(open_at, n)
        repairs <- repairs + 1L
    }
    for (k in seq_along(spans_s)) out[spans_s[k]:spans_e[k]] <- TRUE
    list(in_dialogue = out, repairs = repairs, marker = marker)
}

# ---- Concreteness of head nouns (supporting instrument only) -----------------
# Published norms where the head is listed. Heads absent from the norms fall
# back to a morphological heuristic, and both counts are reported so the reader
# can see how much of the division rests on which instrument.

ABSTRACT_SUFFIX <- "(tion|sion|ment|ness|ity|ance|ence|ism|ship|hood|dom|ency|acy)$"
ABSTRACT_NOUNS  <- c("thing", "way", "fact", "idea", "moment", "reason", "kind",
    "sort", "matter", "question", "sense", "point", "case", "manner", "respect",
    "extent", "degree", "nature", "truth", "mind", "thought", "feeling",
    "notion", "concept", "possibility", "meaning", "purpose", "situation",
    "problem", "effect", "cause", "aspect", "view", "subject", "affair",
    "business")

is_abstract_head_morph <- function(lemma) {
    l   <- tolower(lemma)
    out <- grepl(ABSTRACT_SUFFIX, l) | l %in% ABSTRACT_NOUNS
    out[is.na(l)] <- FALSE
    out
}

# Returns "concrete" / "abstract" / "mid" / NA for a vector of head lemmas.
head_concreteness <- function(lemma) {
    l    <- tolower(lemma)
    res  <- rep(NA_character_, length(l))
    have <- !is.na(l)
    if (!is.null(conc_env$tab)) {
        m   <- conc_env$tab[l[have]]                  # named numeric lookup
        lab <- ifelse(is.na(m), NA_character_,
               ifelse(m >= CONC_HI, "concrete",
               ifelse(m <= CONC_LO, "abstract", "mid")))
        res[have] <- lab
        miss <- have & is.na(res)                     # heads absent from norms
        res[miss] <- ifelse(is_abstract_head_morph(l[miss]), "abstract", "concrete")
        conc_env$n_norm <- conc_env$n_norm + sum(have & !is.na(m))
        conc_env$n_fall <- conc_env$n_fall + sum(miss)
    } else {
        res[have] <- ifelse(is_abstract_head_morph(l[have]), "abstract", "concrete")
        conc_env$n_fall <- conc_env$n_fall + sum(have)
    }
    res
}

# ---- Demonstrative classifier ------------------------------------------------
# Pronominal versus adnominal is pure part of speech from the parse, and carries
# the argument. Complementiser 'that' (SCONJ) and relativiser 'that'
# (PronType=Rel) are excluded. The concrete/abstract division is supporting.

classify_demonstratives <- function(dt) {
    lem   <- tolower(dt$lemma)
    upos  <- dt$upos
    feats <- ifelse(is.na(dt$feats), "", dt$feats)

    is_dem <- ((upos == "DET") | (upos == "PRON" & grepl("PronType=Dem", feats))) &
              upos != "SCONJ" & !grepl("PronType=Rel", feats) &
              lem %in% c("this", "that", "these", "those")

    pol <- ifelse(lem %in% c("this", "these"), "prox",
           ifelse(lem %in% c("that", "those"), "dist", NA_character_))

    hu  <- dt$head_upos
    hl  <- dt$head_lemma
    cls <- rep(NA_character_, nrow(dt))
    cls[is_dem & upos == "PRON"] <- "pron"
    adn <- is_dem & upos == "DET"
    cls[adn] <- "adnom"

    # fine head-type (supporting): common nouns via norms, proper nouns concrete
    conc <- rep(NA_character_, nrow(dt))
    conc[adn & hu %in% "PROPN"] <- "concrete"
    isN <- adn & hu %in% "NOUN"
    conc[isN] <- head_concreteness(hl[isN])
    conc[adn & !(hu %in% c("NOUN", "PROPN"))] <- "unknown"

    list(dem_class = ifelse(is_dem, cls, NA_character_),
         dem_pol   = ifelse(is_dem, pol, NA_character_),
         dem_conc  = ifelse(is_dem & !is.na(cls) & cls == "adnom", conc, NA_character_))
}

# ---- Statistics --------------------------------------------------------------

spearman_fmt <- function(x, y) {
    ok <- complete.cases(x, y)
    if (sum(ok) < 4)
        return(list(txt = sprintf("n=%d too few", sum(ok)), rho = NA_real_, p = NA_real_))
    ct <- suppressWarnings(cor.test(x[ok], y[ok], method = "spearman"))
    list(txt = sprintf("rho = %+.3f  p = %.4g  (n = %d)",
                       ct$estimate, ct$p.value, sum(ok)),
         rho = unname(ct$estimate), p = ct$p.value)
}

# Least-squares changepoint: the split minimising within-segment sums of
# squares, with the observed minimum tested against the same statistic computed
# on random re-orderings of the series.
best_changepoint <- function(v, nperm = 2000, seed = 42) {
    n   <- length(v)
    ssq <- function(a) sum((a - mean(a))^2)
    rss <- function(u) {
        ks <- 2:(n - 2)
        vapply(ks, function(k) ssq(u[1:k]) + ssq(u[(k + 1):n]), numeric(1))
    }
    obs <- rss(v)
    kb  <- (2:(n - 2))[which.min(obs)]
    set.seed(seed)
    perm <- replicate(nperm, min(rss(sample(v))))
    list(k = kb, p = mean(perm <= min(obs)),
         m1 = mean(v[1:kb]), m2 = mean(v[(kb + 1):n]))
}


