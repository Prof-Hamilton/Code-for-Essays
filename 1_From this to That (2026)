    fl <- build_dialogue_flags(a$token, a$upos, a$paragraph_id, strip_quotes = sq)
    a[, in_dialogue := fl$in_dialogue]

    m         <- deixis_masks(a)     # single source of truth
    bare_dist <- m$bare_dist
    prox_adn  <- m$prox_adn
    imm       <- m$imm

    # ---- per-1,000-word narration rates --------------------------------------
    nw_narr <- sum(a$is_word & !a$in_dialogue)
    rate    <- function(mask) 1000 * sum(mask) / max(nw_narr, 1)
    figs[[ttl]] <- data.frame(
        novel = ttl, year = yr, narr_words = nw_narr,
        bare_dist_per1k = round(rate(bare_dist), 3),
        prox_adn_per1k  = round(rate(prox_adn), 3),
        here_now_per1k  = round(rate(m$here_now), 3),
        this_per1k      = round(rate(m$this_dem), 3),
        stringsAsFactors = FALSE)

    ntok <- nrow(a)

    # ---- head noun for adnominal hits, aligned by an explicit row id ----------
    a[, rid := .I]
    a[, sk := paste(doc_id, paragraph_id, sentence_id, sep = "\x1f")]
    hmap <- a[, .(sk, token_id, hl = tolower(lemma), hu = upos)]
    a2 <- merge(a[, .(rid, sk, head_token_id)], hmap,
                by.x = c("sk", "head_token_id"), by.y = c("sk", "token_id"),
                all.x = TRUE, sort = FALSE)
    setorder(a2, rid)
    head_lem <- a2$hl[match(seq_len(ntok), a2$rid)]

    # ---- concordance rows: the sentence is the quotable unit, plus a token
    # ---- window each side and a paragraph/sentence locator --------------------
    CTX_TOK <- CTX_TOK_CFG
    kwic_rows <- function(mask, kind, scores) {
        idx <- which(mask)
        if (!length(idx)) return(NULL)
        out <- vector("list", length(idx))
        for (j in seq_along(idx)) {
            k  <- idx[j]
            L  <- if (k > 1) paste(a$token[max(1, k - CTX_TOK):(k - 1)], collapse = " ") else ""
            Rr <- if (k < ntok) paste(a$token[(k + 1):min(ntok, k + CTX_TOK)], collapse = " ") else ""
            sspan <- a$sentence[k]
            if (is.na(sspan)) sspan <- paste(L, a$token[k], Rr)
            hn <- head_lem[k]
            cm <- conc_lookup(hn)
            out[[j]] <- data.frame(
                novel = ttl, year = yr, kind = kind, score = scores[k],
                node = a$token[k],
                head_noun = ifelse(is.na(hn), "", hn),
                head_conc = ifelse(is.na(cm), NA_real_, round(cm, 2)),
                left = clean_ctx(L), right = clean_ctx(Rr),
                sentence = clean_ctx(sspan),
                locator = sprintf("para %s / sent %s",
                                  a$paragraph_id[k], a$sentence_id[k]),
                stringsAsFactors = FALSE)
        }
        do.call(rbind, out)
    }

    # ---- per-hit scores, each category with its own logic ---------------------
    sent_at <- function(k) {
        s <- a$sentence[k]
        if (is.na(s)) "" else s
    }

    sc_bare <- rep(-Inf, ntok)
    for (k in which(bare_dist)) {
        aft <- if (k < ntok) a$token[k + 1] else ""
        pk  <- k - 1L
        while (pk >= 1 && a$upos[pk] == "PUNCT") pk <- pk - 1L
        pupos <- if (pk >= 1 && a$sentence_id[pk] == a$sentence_id[k] &&
                     a$paragraph_id[pk] == a$paragraph_id[k]) a$upos[pk] else ""
        sc_bare[k] <- score_bare_distal(sent_at(k), aft, pupos)
    }

    sc_padn <- rep(-Inf, ntok)
    for (k in which(prox_adn)) {
        cm <- conc_lookup(head_lem[k])
        cb <- if (is.na(cm)) 0 else if (cm >= 3.5) 2 else if (cm <= 2.5) -1 else 0
        sc_padn[k] <- score_prox(sent_at(k), cb)
    }

    sc_imm <- rep(-Inf, ntok)
    for (k in which(imm)) sc_imm[k] <- score_prox(sent_at(k), 0)

    dedup_keep <- function(df) {
        if (is.null(df)) return(NULL)
        df <- df[order(-df$score), ]
        df <- df[!duplicated(df$sentence), ]
        head(df, N_PER_NOVEL)
    }

    b  <- kwic_rows(bare_dist, "bare_distal",    sc_bare)
    if (!is.null(b))  kw_bare[[ttl]] <- dedup_keep(b)
    pa <- kwic_rows(prox_adn,  "prox_adnominal", sc_padn)
    if (!is.null(pa)) kw_padn[[ttl]] <- dedup_keep(pa)
    im <- kwic_rows(imm,       "prox_immediacy", sc_imm)
    if (!is.null(im)) kw_imm[[ttl]] <- dedup_keep(im)
}

